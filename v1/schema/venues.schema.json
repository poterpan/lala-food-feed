{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "lala-food-feed v1 venues",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "id",
   "cid",
   "name",
   "lat",
   "lng",
   "author",
   "basis"
  ],
  "properties": {
   "id": {
    "type": "string"
   },
   "cid": {
    "type": [
     "string",
     "null"
    ]
   },
   "place_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "amap_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "maps_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "type": "string"
   },
   "address": {
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "lat": {
    "type": "number"
   },
   "lng": {
    "type": "number"
   },
   "category": {
    "type": "string"
   },
   "brand": {
    "type": [
     "string",
     "null"
    ]
   },
   "author": {
    "type": "object",
    "required": [
     "visited",
     "recommends",
     "saved"
    ],
    "properties": {
     "visited": {
      "type": "boolean"
     },
     "recommends": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "saved": {
      "type": "boolean"
     },
     "saved_at": {
      "type": [
       "integer",
       "null"
      ]
     },
     "saved_note": {
      "type": [
       "string",
       "null"
      ]
     },
     "lists": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "title": {
         "type": [
          "string",
          "null"
         ]
        },
        "meaning": {
         "enum": [
          "saved",
          "recommended"
         ]
        }
       }
      }
     }
    }
   },
   "basis": {
    "type": "array",
    "items": {
     "enum": [
      "threads",
      "saved_list"
     ]
    }
   },
   "names_in_threads": {
    "type": "object",
    "additionalProperties": {
     "type": "integer"
    }
   },
   "stance": {
    "type": "object",
    "additionalProperties": {
     "type": "integer"
    }
   },
   "items": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "quotes": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "text",
      "url"
     ],
     "properties": {
      "text": {
       "type": "string"
      },
      "stance": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "date": {
       "type": "string"
      }
     }
    }
   },
   "post_urls": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "related_post_urls": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "first_seen": {
    "type": [
     "string",
     "null"
    ]
   },
   "last_seen": {
    "type": [
     "string",
     "null"
    ]
   },
   "sources": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "tier": {
    "enum": [
     "author_visited",
     "author_endorsed",
     "community_recommended",
     "author_saved",
     "mentioned"
    ]
   },
   "community": {
    "type": "object",
    "properties": {
     "recommendations": {
      "type": "integer"
     },
     "recommenders": {
      "type": "integer"
     },
     "negative": {
      "type": "integer"
     },
     "asked_by_author": {
      "type": "boolean"
     },
     "author_reaction": {
      "enum": [
       "visited",
       "planned",
       "not_yet",
       "unknown"
      ]
     },
     "items": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
