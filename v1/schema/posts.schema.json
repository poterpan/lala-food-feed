{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "lala-food-feed v1 posts",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "url",
   "venue_ids"
  ],
  "properties": {
   "url": {
    "type": "string"
   },
   "type": {
    "enum": [
     "post",
     "reply",
     "quote",
     "repost"
    ]
   },
   "date": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "thread_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "venue_ids": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "about_venue_ids": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "venues": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "id",
      "relation"
     ],
     "properties": {
      "id": {
       "type": "string"
      },
      "relation": {
       "enum": [
        "about",
        "mention",
        "thread"
       ]
      }
     }
    }
   }
  }
 }
}
